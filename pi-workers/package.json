{
  "name": "pi-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "pi-workers": "./dist/cli.js",
    "pi-workers-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "npm run build && PI_WORKERS_SMOKE=1 node --test test/smoke.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.78.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
